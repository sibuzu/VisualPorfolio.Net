FROM python:3.12-slim

WORKDIR /app
ENV STRATEGY_REPORT_DATA_DIR=/app/data

COPY strategy-report/backend/requirements.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt
COPY strategy-report/backend/strategy_report/ ./strategy_report/
COPY docker/strategy-report/entrypoint.backend.sh /app/entrypoint.backend.sh

RUN useradd --system --uid 10001 --home-dir /app strategyreport && mkdir -p /app/data && chown strategyreport:strategyreport /app/data
USER strategyreport

EXPOSE 8000
ENTRYPOINT ["sh", "/app/entrypoint.backend.sh"]
CMD ["uvicorn", "strategy_report.main:app", "--host", "0.0.0.0", "--port", "8000"]
