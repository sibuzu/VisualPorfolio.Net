FROM python:3.12-slim

WORKDIR /app

COPY backend/requirements.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

COPY backend/ ./backend/
COPY docker/visual-portfolio-beta/ensure-beta-data-root.sh /usr/local/bin/ensure-beta-data-root.sh
RUN chmod +x /usr/local/bin/ensure-beta-data-root.sh

EXPOSE 8000

ENTRYPOINT ["ensure-beta-data-root.sh"]
CMD ["uvicorn", "backend.main:app", "--host", "0.0.0.0", "--port", "8000"]
