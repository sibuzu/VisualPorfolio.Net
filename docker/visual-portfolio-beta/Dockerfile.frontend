FROM node:20-alpine AS builder

WORKDIR /app

COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci

COPY frontend/ ./
RUN npm run build

FROM nginx:alpine

RUN rm -rf /usr/share/nginx/html/*
COPY --from=builder /app/dist /usr/share/nginx/html

RUN printf 'map $http_user_agent $is_og_bot {\n\
    default              0;\n\
    "~*Linespider"       1;\n\
    "~*LineBot"          1;\n\
    "~*\\bLine\\b"       1;\n\
    "~*facebookexternalhit" 1;\n\
    "~*Facebot"          1;\n\
    "~*Twitterbot"       1;\n\
    "~*TelegramBot"      1;\n\
    "~*Slackbot"         1;\n\
    "~*WhatsApp"         1;\n\
    "~*LinkedInBot"      1;\n\
    "~*Discordbot"       1;\n\
    "~*pinterest"        1;\n\
    }\n' > /etc/nginx/conf.d/00_og_map.conf

RUN printf 'server {\n\
    listen 80;\n\
    root /usr/share/nginx/html;\n\
    index index.html;\n\
    \n\
    location ~ ^/projects/([^/]+)$ {\n\
    if ($is_og_bot) {\n\
    return 302 https://api-visualporforlio-beta.sibuzu.com$uri/og-preview;\n\
    }\n\
    try_files $uri $uri/ /index.html;\n\
    }\n\
    \n\
    location / {\n\
    try_files $uri $uri/ /index.html;\n\
    }\n\
    \n\
    gzip on;\n\
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml text/javascript;\n\
    }\n' > /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
