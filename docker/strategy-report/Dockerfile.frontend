FROM node:22-alpine AS builder

WORKDIR /app
COPY strategy-report/frontend/package.json strategy-report/frontend/package-lock.json ./
RUN npm ci
COPY strategy-report/frontend/index.html strategy-report/frontend/vite.config.js ./
COPY strategy-report/frontend/src/ ./src/
RUN npm run build

FROM nginx:alpine
COPY docker/strategy-report/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /app/dist/ /usr/share/nginx/html/

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
