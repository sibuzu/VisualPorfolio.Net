<?xml version="1.0" encoding="utf-8"?>
<策略回測>
  <Setting>
    <MddCount>5</MddCount>
    <Compound>
      <管理模式>槓桿倍數目標</管理模式>
      <金額單位_intl>1</金額單位_intl>
      <金額單位>1</金額單位>
      <換倉調整口數>True</換倉調整口數>
      <初始資金_intl>1000000</初始資金_intl>
      <初始資金>1000000</初始資金>
      <使用同一套淨值差序列>True</使用同一套淨值差序列>
      <最大口數>0</最大口數>
      <口數小數點>捨去</口數小數點>
      <固定口數>1</固定口數>
      <風險因子>0.05</風險因子>
      <槓桿資金>累加獲利</槓桿資金>
      <槓桿倍數>0.1</槓桿倍數>
      <回測基準金額>無</回測基準金額>
      <基準金額>10000</基準金額>
      <初始口數>1</初始口數>
      <最小口數>1</最小口數>
      <_獲利基數>50</_獲利基數>
      <獲利基數>50</獲利基數>
      <_交易一口金額>400000</_交易一口金額>
      <交易一口金額>400000</交易一口金額>
      <固定風險比例>0.02</固定風險比例>
      <初始資金風險比例>0.02</初始資金風險比例>
      <已獲利風險比例>0.05</已獲利風險比例>
      <_每次交易風險金額>10000</_每次交易風險金額>
      <每次交易風險金額>10000</每次交易風險金額>
      <保證金目標比例>0.1</保證金目標比例>
      <_每口保證金>100000</_每口保證金>
      <每口保證金>100000</每口保證金>
      <下注比例>20</下注比例>
      <ChipSize>100000</ChipSize>
      <最佳比例>13.06</最佳比例>
      <動態複利初始比例>0.10</動態複利初始比例>
      <動態複利加碼比例>0.15</動態複利加碼比例>
      <動態複利加碼門檻>100000000</動態複利加碼門檻>
      <動態複利回撤門檻Str>2000</動態複利回撤門檻Str>
      <動態複利最大倍數>10</動態複利最大倍數>
      <動態複利複利間隔>每週</動態複利複利間隔>
    </Compound>
  </Setting>
  <策略參數>
